{
  "manifest_version": 3,
  "name": "WebKeyboard",
  "version": "0.1.0",
  "description": "WebKeyboard compatibility layer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@webkeyboard.openpolyfill",
      "strict_min_version": "151.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/isolated/utils/xray.js",
        "content/isolated/utils/webidl.js",
        "content/isolated/service.js",
        "content/isolated/facade.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ]
}
